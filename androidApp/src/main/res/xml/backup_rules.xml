<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older (#116): nothing goes to the cloud backup or to an adb backup. The app has
  allowBackup="false" already; this keeps the same rule if that ever changes.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
